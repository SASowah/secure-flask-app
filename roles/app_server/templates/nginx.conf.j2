server {
    listen 80;
    server_name secureflask.duckdns.org www.secureflask.duckdns.org;
    

    # Redirect all HTTP requests to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name secureflask.duckdns.org www.secureflask.duckdns.org;


    ssl_certificate /etc/letsencrypt/live/secureflask.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/secureflask.duckdns.org/privkey.pem;

    root /opt/flask_app/src;
    index index.html;

    location / {
        proxy_pass http://127.0.0.1:5000; # Assuming your app is running on port 5000
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
