pipeline {
    agent { label 'flask-agent' }

    stages {
        stage('Checkout Code') {
            steps {
                script {
                    git branch: "dev",
                        url: 'https://github.com/SASowah/secure-flask-app.git'
                }
            }
        }

        stage('Set up Python Environment') {
            steps {
                sh '''
                python3 -m venv venv
                source venv/bin/activate
                pip install --upgrade pip
                pip install -r requirements.txt
                '''
            }
        }

        stage('Generate Artifact Hash') {
            steps {
                sh '''
                source venv/bin/activate
                tar -cf app.tar.gz app.py init.db.js requirements.txt
                sha256sum app.tar.gz > artifact_hash.txt
                '''
            }
        }

        stage('Verify Artifact Integrity') {
            steps {
                script {
                    def expectedHash = sh(script: "cat artifact_hash.txt | awk '{print $1}'", returnStdout: true).trim()
                    def calculatedHash = sh(script: "sha256sum app.tar.gz | awk '{print $1}'", returnStdout: true).trim()
                    
                    if (expectedHash != calculatedHash) {
                        error("❌ Artifact integrity check failed! Expected: ${expectedHash}, but got: ${calculatedHash}")
                    } else {
                        echo "✅ Artifact integrity verified successfully!"
                    }
                }
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                source venv/bin/activate
                pytest --junitxml=report.xml
                '''
            }
        }

        stage('Deploy with Ansible') {
            steps {
                script {
                    sh '''
                    ansible-playbook -i hosts_inventory.ini deploy.yml
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo '❌ Build Failed! Check logs for issues.'
        }
    }
}
